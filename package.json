{
  "name": "qa-automation-framework",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:web": "cypress run --spec \"cypress/e2e/features/web/**/*.feature\"",
    "cy:run:web:public": "cypress run --spec \"cypress/e2e/features/web/busca.feature,cypress/e2e/features/web/carrinho.feature\"",
    "cy:run:web:auth": "cypress run --spec \"cypress/e2e/features/web/login.feature,cypress/e2e/features/web/checkout.feature\"",
    "cy:run:api": "cypress run --spec \"cypress/e2e/features/api/**/*.feature\"",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "test": "npm run cy:run && npm run allure:generate && npm run allure:open"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^20.0.4",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.2",
    "@shelex/cypress-allure-plugin": "^2.40.2",
    "allure-commandline": "^2.29.0",
    "cypress": "^13.13.0",
    "dotenv": "^16.4.5"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "cypress/steps/**/*.js"
    ],
    "filterSpecs": true,
    "omitFiltered": true
  }
}
