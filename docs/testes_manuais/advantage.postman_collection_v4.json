  "item": [
    {
      "name": "Pesquisa de Produtos - API",
      "item": [
        {
          "name": "CT01 - Pesquisa por produto existente",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{catalogo}}{{buscarProduto}}?name=HP%20Z3600%20Wireless%20Mouse",
              "host": [
                "{{baseUrl}}{{catalogo}}{{buscarProduto}}"
              ],
              "query": [
                {
                  "key": "name",
                  "value": "HP Z3600 Wireless Mouse"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Resposta possui formato JSON válido\", function () {",
                  "    const contentType = pm.response.headers.get(\"Content-Type\") || \"\";",
                  "    pm.expect(contentType.toLowerCase()).to.include(\"json\");",
                  "    pm.expect(pm.response.json()).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"Retorna o produto pesquisado\", function () {",
                  "    const body = pm.response.json();",
                  "    const products = body.flatMap(category => Array.isArray(category.products) ? category.products : []);",
                  "    pm.expect(products.some(product => product.productName === \"HP Z3600 Wireless Mouse\")).to.be.true;",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ]
        },
        {
          "name": "CT02 - Pesquisa por parte do nome",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{catalogo}}{{buscarProduto}}?name=mous",
              "host": [
                "{{baseUrl}}{{catalogo}}{{buscarProduto}}"
              ],
              "query": [
                {
                  "key": "name",
                  "value": "mous"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Resposta possui formato JSON válido\", function () {",
                  "    const contentType = pm.response.headers.get(\"Content-Type\") || \"\";",
                  "    pm.expect(contentType.toLowerCase()).to.include(\"json\");",
                  "    pm.expect(pm.response.json()).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"Todos os produtos retornados correspondem ao termo pesquisado\", function () {",
                  "    const term = \"mous\";",
                  "    const body = pm.response.json();",
                  "    const products = body.flatMap(category => Array.isArray(category.products) ? category.products : []);",
                  "    pm.expect(products.length).to.be.greaterThan(0);",
                  "    products.forEach(product => pm.expect(product.productName.toLowerCase()).to.include(term));",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ]
        },
        {
