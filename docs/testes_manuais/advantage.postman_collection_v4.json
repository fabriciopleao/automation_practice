        {
          "name": "CT05 - Limite de produtos por categoria",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{catalogo}}{{buscarProduto}}?name=Mouse&quantityPerEachCategory=2",
              "host": [
                "{{baseUrl}}{{catalogo}}{{buscarProduto}}"
              ],
              "query": [
                {
                  "key": "name",
                  "value": "Mouse"
                },
                {
                  "key": "quantityPerEachCategory",
                  "value": "2"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Resposta possui formato JSON válido\", function () {",
                  "    const contentType = pm.response.headers.get(\"Content-Type\") || \"\";",
                  "    pm.expect(contentType.toLowerCase()).to.include(\"json\");",
                  "    pm.expect(pm.response.json()).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"Respeita o limite de produtos por categoria\", function () {",
                  "    const body = pm.response.json();",
                  "    body.forEach(category => {",
                  "        pm.expect(category.products).to.be.an(\"array\");",
                  "        pm.expect(category.products.length).to.be.at.most(2);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ]
        },
        {
          "name": "CT06 - Validação de contrato",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{catalogo}}{{buscarProduto}}?name=Mouse",
              "host": [
