          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const schema = {\"type\": \"array\", \"items\": {\"type\": \"object\", \"required\": [\"categoryId\", \"categoryName\", \"categoryImageId\", \"products\"], \"properties\": {\"categoryId\": {\"type\": \"integer\"}, \"categoryName\": {\"type\": \"string\"}, \"categoryImageId\": {\"type\": \"string\"}, \"products\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"required\": [\"productId\", \"categoryId\", \"productName\", \"price\", \"imageUrl\"], \"properties\": {\"productId\": {\"type\": \"integer\"}, \"categoryId\": {\"type\": \"integer\"}, \"productName\": {\"type\": \"string\"}, \"price\": {\"type\": \"number\"}, \"imageUrl\": {\"type\": \"string\"}}, \"additionalProperties\": true}}}, \"additionalProperties\": true}};",
                  "",
                  "pm.test(\"Contrato mínimo da resposta é válido\", function () {",
                  "    pm.response.to.have.jsonSchema(schema);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ]
        },
